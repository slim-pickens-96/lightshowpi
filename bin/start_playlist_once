#!/bin/bash

# Run the files in the playlist once
# Author: Ken B
# Usage: start_playlist_once [ .playlist ]

PLAYLIST=$1

if [ ! -f "${PLAYLIST}" ]; then
    echo "Playlist ${PLAYLIST} not found"
    exit 1
fi

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

. "$DIR/lightshowpi-env.sh"

"$SYNCHRONIZED_LIGHTS_HOME/bin/stop_music_and_lights" $$

SONGCOUNT=$(wc -l < "$PLAYLIST")
for (( i=1; i<=SONGCOUNT; i++ ))
do
    lsp_python "$SYNCHRONIZED_LIGHTS_HOME/py/synchronized_lights.py" --playlist="$PLAYLIST"
done

# Uncomment if you want to leave lights on after show

#lsp_python "$SYNCHRONIZED_LIGHTS_HOME/py/hardware_controller.py" --state=on
