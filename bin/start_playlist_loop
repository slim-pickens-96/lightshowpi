#!/bin/bash

# Run the files in the playlist in a loop
# Author: Ken B
# Usage: start_playlist_loop [ .playlist ]

PLAYLIST=$1

if [ ! -f "${PLAYLIST}" ]; then
    echo "Playlist ${PLAYLIST} not found"
    exit 1
fi

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

. "$DIR/lightshowpi-env.sh"

"$SYNCHRONIZED_LIGHTS_HOME/bin/stop_music_and_lights" $$

while true; do
    lsp_python "$SYNCHRONIZED_LIGHTS_HOME/py/synchronized_lights.py" --playlist="$PLAYLIST"
done

